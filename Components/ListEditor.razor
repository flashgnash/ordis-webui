@typeparam TItem

<div class="d-flex flex-column gap-1">
    <div class="d-flex align-items-center">
        <label class="form-label mb-0 small fw-bold">@Items?.Count() @(Name)(s)</label>
        @if(Hint != null) {
            <span title="@Hint" class="ms-1 small" style="cursor: default; user-select: none; color:var(--accent)">?</span>
        }
        <div class="flex-grow-1"></div>
        <button type="button" class="btn btn-primary btn-sm p-0" style="width:1.8em;height:1.8em" @onclick="AddItem">+</button>
    </div>
    @if (Items != null)
    {
        <div class="d-flex flex-wrap gap-1">
            @foreach (var item in Items)
            {
                <div class="d-flex flex-nowrap" style="flex: 1 1 14em; min-width: 0">
                    <div @key="item" class="card flex-grow-1 px-2 py-1 d-flex flex-wrap" style="min-width: 0; color: white">
                        @ItemTemplate(item)
                    </div>
                    <button @onclick="() => RemoveItem(item)" class="btn btn-danger flex-shrink-0 d-flex align-items-center justify-content-center" style="width:2em; border-top-left-radius:0; border-bottom-left-radius:0" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                          <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                        </svg>
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ICollection<TItem> Items { get; set; }
    [Parameter] public EventCallback AddItem { get; set; }
    [Parameter] public RenderFragment<TItem> ItemTemplate { get; set; }
    [Parameter] public string Name { get; set; }
    [Parameter] public string? Hint {get; set;}

    void RemoveItem(TItem item)
    {
        Items.Remove(item);
    }
}
