@{
    var list = Stats.ToList();
    var buffs = Buffs ?? Enumerable.Empty<Buff>();
    var ctx = BuffContext ?? new Dictionary<string, double>();
}

<div class="d-flex flex-wrap gap-1 w-100">
    @foreach (var stat in list)
    {
        var baseVal = (double)(stat.Value ?? 0);
        var effective = BuffFormula.ComputeEffective(buffs, stat.Name, baseVal, ctx);
        var delta = (int)Math.Round(effective - baseVal);

        <div class="stat-pill">
            <span class="stat-pill-label">@Truncate(stat.Name)</span>
            <span class="stat-pill-value">
                @stat.Value
                @if (delta != 0)
                {
                    <span class="@(delta > 0 ? "text-success" : "text-danger")">@(delta > 0 ? "+" : "")@delta</span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<Stat> Stats { get; set; }
    [Parameter] public IEnumerable<Buff>? Buffs { get; set; }
    [Parameter] public Dictionary<string, double>? BuffContext { get; set; }

    private string Truncate(string s) => s[..Math.Min(3, s.Length)];
}
