@page "/characters/{characterId:int}"
@inject PlayerCharacterService CharService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "HasDiscordId")]
@inject UserState UserState
@inject BuffService BuffService
@inject LiveUpdateService LiveUpdates
@implements IDisposable
@rendermode InteractiveServer


@if (Char != null)
{
    <Modal Title="Roll" id="rollDialog">
        <div class=p-3>
            <RollMenu Character="@Char" />
        </div>
    </Modal>


	<Modal Title="Edit Character" id="editCharacterDialog">
	    <div class=p-3>
			<CharacterCRUD Character="@Char"/>
	    </div>
	</Modal>
    
            
    <div class="disable-dbl-tap-zoom container mt-4 vh-100" style="overflow: auto">
        <div class="w-100 p-2 d-flex">
            <div class="d-flex flex-row w-100">
                <div class="flex-grow-1">
                    <span class="fs-2">
                        @Char.Name

                        <button onClick="editCharacterDialog.showModal()" style="color:var(--accent)">
                    				 <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                    					  <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                    					</svg>
                        </button>
                    </span>
                    <div>
                        Level @Char.StatBlock?.Level
                    </div>
                </div>

                <a onClick="rollDialog.showModal()" class="float-right btn btn-primary p-2 rounded-3 d-flex justify-content-center">
                    <svg
                        width="50"
                        height="45"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        class="bi bi-dice-5-fill m-auto"
                        viewBox="0 0 16 16">
                        <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
                    </svg>
                </a>
            </div>
        </div>
        
        @if (Char?.StatBlock?.Stats != null)
        {
            <div class="p-2">
                <StatBlock Stats="@Char.StatBlock.Stats"
                           Buffs="@ActiveBuffTemplates()"
                           BuffContext="@BuildBuffContext()" />
            </div>
        }

        @if (Char?.Gauges != null)
        {
            <!-- Globes -->
            <div class="d-flex gap-2 m-auto" style="max-width: 100%; padding: 5px;">
                @foreach (var gauge in Char.Gauges)
                {
                    @if (!(gauge?.Max == 0 && gauge?.Value == 0))
                    {
                        <GaugeDisplay GaugeInstance="@gauge" MaxBonus="@GetGaugeBonus(gauge!.Name)" ChangedCallback="@GaugeChangedCallback"/>
                    }

                }
            </div>
        }

        <div class="m-2">
            <BuffList Character="@Char" OwnerId="@DiscordId"
                      CharacterBuffs="@characterBuffs"
                      OnChanged="@OnBuffsChanged"
                      OnStackApplied="@OnCumulativeStackApplied" />
        </div>
        <div class="">
            <div class="flex-grow-2 flex-row flex-wrap">
                @if (Char?.StatBlock?.Hunger != null && Char?.StatBlock?.Hunger != 0)
                {
                    <div class="card flex-fill">
                        <div class="card-header">Hunger:</div>
                        <div class="card-body fs-7">
                            <span>
                                @Char.StatBlock?.Hunger / 10
                            </span>
                            <br />
                            <span class="d-none d-md-inline">
                                <CharBar Repeat="@(Char.StatBlock?.Hunger ?? 10)" Icon="🍖" />
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>


        <br>
        @if(Char.Rolls != null) {
            <div class="d-flex flex-wrap">
                <div class="flex-grow-1 card">
                    <div class="card-header">
                        <span class="d-flex gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-dice-6-fill m-auto" viewBox="0 0 16 16">
                              <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm1 5.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m8 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m1.5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M4 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"/>
                            </svg>
                            Rolls
                             <div class="flex-grow-1"> </div>
                            (@(Char.Rolls?.Count() ?? 0))
                        </span>
                    </div>
                    <div class="flex-fill card-body p-2 w-100" style="max-height: 10em; overflow: auto;">

                        <table class="table spaced">
                            <tbody>
                                @foreach (RollResult roll in (Char.Rolls ?? Enumerable.Empty<RollResult>()).OrderByDescending(r => r.Timestamp))
                                {
                                    <tr>
                                       <td class="text-muted">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-clock-fill" viewBox="0 0 16 16">
                                              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z"/>
                                            </svg>
                                            @FormatRollTimestamp(roll.Timestamp)
                                        </td>

                                        <td>

                                            <svg
                                                width="1em"
                                                height="1em"
                                                xmlns="http://www.w3.org/2000/svg"
                                                fill="currentColor"
                                                class="bi bi-dice-5-fill m-auto"
                                                viewBox="0 0 16 16">
                                                <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
                                            </svg>
                                            <RollFace Roll="roll" Size="1.8em" />
                                        </td>

                                        
                                    </tr>
                                }
                            </tbody>
                        </table>


                    
                    </div>
                </div>
            </div>
        }
        
        <!-- Quick and dirty margin at the bottom if scrolling -->
        <br>
        <br>
    </div>
}
else
{
    <h1>Either this character doesn't exist or you don't have access</h1>
}

@code
{
    PlayerCharacter? Char;
    List<CharacterBuff> characterBuffs = new();
    string? DiscordId;

    [Parameter] public int CharacterId { get; set; }

    private List<Buff> ActiveBuffTemplates() =>
        characterBuffs.Select(cb => new Buff
        {
            Name = cb.Template.Name,
            Icon = cb.Template.Icon,
            Type = cb.Template.Type,
            Effects = cb.Template.Effects.Select(e => new Effect
            {
                Formula = e.Formula,
                IsCumulative = e.IsCumulative,
                Stacks = e.IsCumulative ? cb.Stacks : 1
            }).ToList()
        }).ToList();

    public async Task GaugeChangedCallback(Gauge gauge)
    {
        if (gauge.Id == Guid.Empty)
            gauge.Id = Guid.NewGuid();


        <!-- Console.WriteLine($"Gauges: {Char.Gauges.Count()}"); -->


        <!-- await CharService.UpdateGaugeAsync(gauge); -->
        await CharService.UpdateGaugeAsync(gauge);
        <!-- Console.WriteLine($"Gauges: {Char.Gauges.Count()}"); -->

    }

    private Dictionary<string, double> BuildBuffContext() =>
        BuffFormula.BuildContext(Char?.StatBlock, Char?.Gauges);

    private int GetGaugeBonus(string gaugeName)
    {
        var buffs = ActiveBuffTemplates();
        var gauge = Char?.Gauges?.FirstOrDefault(g =>
            g.Name.Equals(gaugeName, StringComparison.OrdinalIgnoreCase));
        if (gauge == null) return 0;
        var ctx = BuildBuffContext();
        // Effects can target the gauge by name OR name+".max"
        var effective = BuffFormula.ComputeEffective(
            buffs,
            [gaugeName, gaugeName + ".max"],
            (double)gauge.Max,
            ctx);
        return (int)Math.Round(effective - gauge.Max);
    }

    private async Task OnCumulativeStackApplied(CharacterBuff cb)
    {
        if (Char?.Gauges == null) return;
        // Build a Buff with the current stacks for delta calculation
        var buff = new Buff
        {
            Name = cb.Template.Name,
            Effects = cb.Template.Effects.Select(e => new Effect
            {
                Formula = e.Formula,
                IsCumulative = e.IsCumulative,
                Stacks = e.IsCumulative ? cb.Stacks : 1
            }).ToList()
        };
        var ctx = BuildBuffContext();
        foreach (var gauge in Char.Gauges)
        {
            var delta = BuffFormula.ComputeGaugeValueDelta(buff, gauge.Name, ctx);
            if (delta != 0)
            {
                gauge.Value = Math.Max(0, Math.Min(gauge.Value + delta, gauge.Max + GetGaugeBonus(gauge.Name)));
                await CharService.UpdateGaugeAsync(gauge);
            }
        }
    }

    private async Task OnBuffsChanged()
    {
        characterBuffs = await BuffService.GetCharacterBuffsAsync(Char!.Id);
        StateHasChanged();
    }


    protected async override Task OnInitializedAsync()
    {
        var character = await CharService.GetByIdAsync(CharacterId);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        DiscordId = user.FindFirst("discord_id")?.Value ?? "Not logged in";

        // Allow access if the user owns the character or is the DM of its campaign
        // (this is only safe because I'm using serverside blazor)
        var isDm = character?.Campaign?.DungeonMasterId == DiscordId;
        if (character != null && (character.UserId == DiscordId || isDm))
        {
            UserState.SelectedCharacter = character;
            Char = character;
            characterBuffs = await BuffService.GetCharacterBuffsAsync(character.Id);

            if (character.Gauges?.Count == 0 && character.StatBlock?.MaxHealth != null)
            {
                var newGauge = new Gauge {
                    Id = Guid.NewGuid(),
                    PlayerCharacterId = Char.Id,
                    Name = "Health",
                    Max = character.StatBlock?.MaxHealth ?? 0,
                    Value = character.StatBlock?.CurrentHealth ?? character.StatBlock?.MaxHealth ?? 0,
                };

                character.Gauges.Add(newGauge);
            }

            LiveUpdates.OnCharacterChanged += OnCharacterUpdated;
        }
        else
        {
            Navigation.NavigateTo("/forbidden");
        }
    }

    private async void OnCharacterUpdated(int characterId)
    {
        if (characterId != CharacterId) return;

        await InvokeAsync(async () =>
        {
            var updated = await CharService.GetByIdAsync(CharacterId);
            if (updated != null)
            {
                Char = updated;
                characterBuffs = await BuffService.GetCharacterBuffsAsync(CharacterId);
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        LiveUpdates.OnCharacterChanged -= OnCharacterUpdated;
    }

    private static string FormatRollTimestamp(DateTime? timestamp)
    {
        if (timestamp == null) return "";

        var local = timestamp.Value.Kind == DateTimeKind.Utc
            ? timestamp.Value.ToLocalTime()
            : timestamp.Value;
        var now = DateTime.Now;

        if (local.Date != now.Date)
            return local.ToString("MMM d HH:mm");

        var age = now - local;
        if (age.TotalSeconds < 60) return "now";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        return $"{(int)age.TotalHours}h ago";
    }
}
