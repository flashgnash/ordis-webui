@rendermode InteractiveServer
@page "/campaigns/{campaignId:int}"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CampaignService CampaignService
@inject PlayerCharacterService CharService
@inject BuffService BuffService
@inject IJSRuntime JS
@inject LiveUpdateService LiveUpdates
@implements IDisposable
@attribute [Authorize(Policy = "HasDiscordId")]


@if(Campaign != null) {

	<Modal Title="Edit Campaign" id="editCampaignDialog">
	    <div class=p-3>
			<CampaignCRUD Campaign="@Campaign"/>
	    </div>
	</Modal>

    <Modal Title="Roll" id="rollDialog">
        <div class=p-3>
            <RollMenu />
        </div>
    </Modal>

    <div class="disable-dbl-tap-zoom container-fluid mt-4 vh-100" style="overflow: auto">
        <!-- Header: title + tags + dice -->
        <div class="d-flex flex-nowrap align-items-start p-2">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <span class="fs-2">@Campaign.Name</span>
                    <button class="fs-3 ms-2" onClick="editCampaignDialog.showModal()" style="color:var(--accent)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                        </svg>
                    </button>
                </div>
                <div class="d-flex gap-2 mt-1">
                    @if (!string.IsNullOrEmpty(Campaign.DefaultRollDie))
                    {
                        <span class="badge bg-secondary">Default die: @Campaign.DefaultRollDie</span>
                    }
                    <span class="badge bg-secondary">Modifier formula: @(Campaign.StatModifierFormula ?? "5e")</span>
                </div>
            </div>
            <a onClick="rollDialog.showModal()" class="btn btn-primary p-2 rounded-3 d-flex justify-content-center flex-shrink-0">
                <svg width="50" height="45" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-dice-5-fill m-auto" viewBox="0 0 16 16">
                    <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
                </svg>
            </a>
        </div>

        <!-- Two-column layout: players left, modifier library right -->
        <div class="d-flex flex-column flex-xl-row gap-3 mt-2 align-items-stretch align-items-xl-start">
            <div style="flex: 1 1 0%; min-width: 0">
                <h5 class="mb-2">Players (@VisiblePlayers.Count())</h5>
                @if(Campaign.Players != null){
                <div class="player-grid">
                    @foreach(PlayerCharacter player in VisiblePlayers) {
                        <Modal Title="Edit Player" id="@(GetIdentifier(player,"edit"))">
                            <div class=p-3>
                                <CharacterCRUD Character="@player"/>
                            </div>
                        </Modal>

                        <Modal Title="Delete Player" id="@(GetIdentifier(player,"delete"))">
                            <h2>Do you really want to delete the character "@player.Name"?</h2>
                            <br>
                            <div class="form-group">
                                <h5 class="text-muted">Please type the name of your campaign to confirm:</h5>
                                <input class="form-input fs-5 m-2" placeholder=@player.Name @bind="@NameDeletionConfirmationBoxes[player.Id]">
                            </div>
                            <button class="btn btn-danger w-100"
                                    disabled="@(NameDeletionConfirmationBoxes[player.Id] != player.Name)"
                                    @onclick="async () => await DeletePlayerWithCloseAsync(player)">
                                Delete
                            </button>
                        </Modal>

                        <div class="card player-card">
                            <div class="card-header py-0 px-2">
                                <div class="text-white d-flex align-items-center">
                                    @if(player.UserId == DiscordId) {
                                        <a style="color:var(--accent)" href="@($"/characters/{player.Id}")">@(player.Name ?? "Unknown") (you)</a>
                                    }
                                    else {
                                        <span>@(player.Name ?? "Unknown")</span>
                                    }
                                    <div class="flex-grow-1"></div>
                                    <button class="text-danger p-1" onClick="@(GetIdentifier(player,"delete")).showModal()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                            <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                        </svg>
                                    </button>
                                    <button class="p-1" style="color:var(--accent)" onClick="@(GetIdentifier(player,"edit")).showModal()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-2 w-100">
                                @if(player.Gauges != null) {
                                    <div class="d-flex align-items-center gap-3 w-100">
                                        <div class="d-flex flex-column gap-1" style="flex: 1 1 0%; min-width: 0">
                                            @foreach(Gauge gauge in player.Gauges) {
                                                <Bar GaugeInstance="@gauge" />
                                            }
                                        </div>
                                        @{
                                            var lastRoll = player?.Rolls?.OrderByDescending(r => r.Timestamp).FirstOrDefault();
                                        }
                                        @if (lastRoll != null)
                                        {
                                            <div class="flex-shrink-0">
                                                <DieShape Expression="@(lastRoll.Rolls?.FirstOrDefault()?.Expression ?? lastRoll.Message)">
                                                    @lastRoll.Result
                                                </DieShape>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                }

            </div>

            <div style="flex: 1 1 280px">
                <h5 class="mb-2">Modifier Library</h5>
                <div class="card m-0 border-0">
                    <div class="card-body m-0 p-0">
                        <div class="d-flex align-items-center" style="border-bottom: 1px solid rgba(255,255,255,0.1)">
                            @foreach (var tab in modTabs)
                            {
                                var isActive = activeModTab == tab;
                                var count = campaignBuffs.Count(t => t.Type == tab);
                                <a href="javascript:void(0)"
                                   @onclick="() => activeModTab = tab"
                                   style="padding: 0.5em 0.7em; text-decoration: none; color: @(isActive ? "var(--accent)" : "rgba(255,255,255,0.5)"); border-bottom: 2px solid @(isActive ? "var(--accent)" : "transparent"); font-size: 0.85em; white-space: nowrap">
                                    @ModTabLabel(tab)
                                    @if (count > 0)
                                    {
                                        <span style="margin-left: 0.3em; font-size: 0.85em; opacity: 0.7">@count</span>
                                    }
                                </a>
                            }
                            <div class="flex-grow-1"></div>
                            <button class="btn btn-primary btn-sm flex-shrink-0 me-2" @onclick="OpenCampaignBuffDialog">+</button>
                        </div>

                        <div class="p-2">
                            @{ var tabMods = campaignBuffs.Where(t => t.Type == activeModTab).OrderBy(t => t.Name).ToList(); }
                            @if (tabMods.Any())
                            {
                                @foreach (var t in tabMods)
                                {
                                    <div class="d-flex align-items-center gap-2 py-1">
                                        <span class="flex-shrink-0 text-muted" style="width: 1.5em; text-align: center">
                                            <BuffIcon Name="@t.Icon" />
                                        </span>
                                        <span>@t.Name</span>
                                        <div class="flex-grow-1"></div>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var effect in t.Effects)
                                            {
                                                var p = BuffFormula.Parse(effect.Formula);
                                                var positive = p?.op is "+=" or "*=";
                                                <span class="badge @(positive ? "bg-success" : "bg-danger")"
                                                      style="font-size: 0.7em">
                                                    @BuffFormula.FormatDisplay(effect.Formula)
                                                </span>
                                            }
                                        </div>
                                        <button class="btn btn-danger btn-sm" style="padding: 2px 7px; line-height: 1"
                                                @onclick="() => DeleteCampaignBuff(t)">
                                            x
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No @ModTabLabel(activeModTab).ToLower()</span>
                            }
                        </div>
                    </div>
                </div>

                @if(IsDM) {
                <div class="mt-4">
                    <div class="d-flex align-items-center mb-2">
                        <h5 class="mb-0">NPCs (@VisibleNpcs.Count())</h5>
                        <button class="btn btn-primary btn-sm ms-2" @onclick="CreateNpcAsync">+</button>
                    </div>
                    <div class="player-grid">
                        @foreach(PlayerCharacter npc in VisibleNpcs) {
                            <Modal Title="Edit NPC" id="@(GetIdentifier(npc,"edit"))">
                                <div class=p-3>
                                    <CharacterCRUD Character="@npc"/>
                                </div>
                            </Modal>

                            <Modal Title="Delete NPC" id="@(GetIdentifier(npc,"delete"))">
                                <h2>Do you really want to delete the NPC "@npc.Name"?</h2>
                                <br>
                                <div class="form-group">
                                    <h5 class="text-muted">Please type the name to confirm:</h5>
                                    <input class="form-input fs-5 m-2" placeholder=@npc.Name @bind="@NameDeletionConfirmationBoxes[npc.Id]">
                                </div>
                                <button class="btn btn-danger w-100"
                                        disabled="@(NameDeletionConfirmationBoxes[npc.Id] != npc.Name)"
                                        @onclick="async () => await DeleteNpcWithCloseAsync(npc)">
                                    Delete
                                </button>
                            </Modal>

                            <div class="card player-card">
                                <div class="card-header py-0 px-2">
                                    <div class="text-white d-flex align-items-center">
                                        <a style="color:var(--accent)" href="@($"/characters/{npc.Id}")">@(npc.Name ?? "Unknown")</a>
                                        <div class="flex-grow-1"></div>
                                        <button class="text-danger p-1" @onclick="async () => await HandleNpcDeleteClickAsync(npc)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                            </svg>
                                        </button>
                                        <button class="p-1" style="color:var(--accent)" onClick="@(GetIdentifier(npc,"edit")).showModal()">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-2 w-100">
                                    @if(npc.Gauges != null) {
                                        <div class="d-flex align-items-center gap-3 w-100">
                                            <div class="d-flex flex-column gap-1" style="flex: 1 1 0%; min-width: 0">
                                                @foreach(Gauge gauge in npc.Gauges) {
                                                    <Bar GaugeInstance="@gauge" />
                                                }
                                            </div>
                                            @{
                                                var lastNpcRoll = npc?.Rolls?.OrderByDescending(r => r.Timestamp).FirstOrDefault();
                                            }
                                            @if (lastNpcRoll != null)
                                            {
                                                <div class="flex-shrink-0">
                                                    <DieShape Expression="@(lastNpcRoll.Rolls?.FirstOrDefault()?.Expression ?? lastNpcRoll.Message)">
                                                        @lastNpcRoll.Result
                                                    </DieShape>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                }
            </div>
        </div>

        <Modal Title="Add campaign buff" id="campaignBuffDialog">
            <div class="p-3 d-flex flex-column gap-3" style="min-width: 360px">
                <div class="d-flex flex-wrap gap-3">
                    <div class="flex-grow-1" style="min-width: 150px">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="cbName" />
                    </div>
                    <div class="flex-grow-1" style="min-width: 120px">
                        <label class="form-label">Type</label>
                        <select class="form-select bg-dark text-white border-0" @bind="cbType">
                            <option value="@BuffType.Equipment">Equipment</option>
                            <option value="@BuffType.Status">Status</option>
                            <option value="@BuffType.Skill">Skill</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-1">
                    @foreach (var icon in BuffIcon.AllIcons)
                    {
                        var selected = cbIcon == icon;
                        <button type="button"
                                class="btn btn-sm d-flex align-items-center justify-content-center"
                                style="width: 2.2em; height: 2.2em; padding: 0; border: 2px solid @(selected ? "var(--accent)" : "transparent"); color: @(selected ? "var(--accent)" : "rgba(255,255,255,0.5)")"
                                @onclick="() => cbIcon = icon">
                            <BuffIcon Name="@icon" Size="1.1em" />
                        </button>
                    }
                </div>

                <div>
                    <div class="d-flex align-items-center">
                        <label class="form-label mb-0">Effects</label>
                        <button type="button" class="btn btn-primary btn-sm ms-auto" @onclick="AddCbEffect">+</button>
                    </div>
                    @for (int i = 0; i < cbEffects.Count; i++)
                    {
                        var idx = i;
                        <div class="d-flex gap-1 align-items-center mt-1">
                            <input class="form-control" @bind="cbEffects[idx]" placeholder="e.g. str+=2" />
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => cbEffects.RemoveAt(idx)">x</button>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary flex-fill" onclick="campaignBuffDialog.close()">Cancel</button>
                    <button type="button" class="btn btn-primary flex-fill" @onclick="SaveCampaignBuff">Save</button>
                </div>
            </div>
        </Modal>

    </div>


}

@code {
	Campaign? Campaign;
    [Parameter] public int CampaignId { get; set; }

	List<BuffTemplate> campaignBuffs = new();
	Dictionary<int,string> NameDeletionConfirmationBoxes {get; set;} = new();

	private static readonly BuffType[] modTabs = [BuffType.Equipment, BuffType.Status, BuffType.Skill];
	private BuffType activeModTab = BuffType.Equipment;
	private static string ModTabLabel(BuffType type) => type switch
	{
		BuffType.Equipment => "Equipment",
		BuffType.Status => "Statuses",
		BuffType.Skill => "Skill Modifiers",
		_ => type.ToString()
	};

	private string DiscordId {get; set;}

	private bool IsDM => Campaign?.DungeonMasterId == DiscordId;

	private IEnumerable<PlayerCharacter> VisiblePlayers => (Campaign?.Players ?? Enumerable.Empty<PlayerCharacter>())
		.Where(p => !p.IsNpc && (IsDM || p.UserId == DiscordId))
		.OrderByDescending(c => c.Rolls.Any())
		.ThenByDescending(c => c.Rolls.Max(r => r.Timestamp));

	private IEnumerable<PlayerCharacter> VisibleNpcs => (Campaign?.Players ?? Enumerable.Empty<PlayerCharacter>())
		.Where(p => p.IsNpc)
		.OrderBy(p => p.Name);

	public async Task DeletePlayerAsync(PlayerCharacter character) {
		await CampaignService.RemovePlayerAsync(Campaign,character);
	}

	private async Task CloseModalAsync(string id)
	{
		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", id);
		await dialog.InvokeVoidAsync("close");
	}

	private async Task DeletePlayerWithCloseAsync(PlayerCharacter player)
	{
		await CloseModalAsync(GetIdentifier(player, "delete"));
		await DeletePlayerAsync(player);
	}

	private async Task DeleteNpcWithCloseAsync(PlayerCharacter npc)
	{
		await CloseModalAsync(GetIdentifier(npc, "delete"));
		await DeleteNpcWithGraceAsync(npc);
	}

	private DateTime? _lastNpcDeleted;
	private bool NpcGracePeriodActive => _lastNpcDeleted.HasValue && (DateTime.UtcNow - _lastNpcDeleted.Value).TotalSeconds < 30;

	private async Task HandleNpcDeleteClickAsync(PlayerCharacter npc)
	{
		if (NpcGracePeriodActive)
		{
			_lastNpcDeleted = DateTime.UtcNow;
			await DeletePlayerAsync(npc);
		}
		else
		{
			await JS.InvokeVoidAsync("eval", $"document.getElementById('{GetIdentifier(npc, "delete")}').showModal()");
		}
	}

	private async Task DeleteNpcWithGraceAsync(PlayerCharacter npc)
	{
		_lastNpcDeleted = DateTime.UtcNow;
		await DeletePlayerAsync(npc);
	}

	public async Task CreateNpcAsync() {
		await CampaignService.AddNpcAsync(CampaignId);
		Campaign = await CampaignService.GetByIdAsync(CampaignId);
		Campaign.Players = Campaign.Players ?? new List<PlayerCharacter>();
		foreach (PlayerCharacter p in Campaign.Players)
			NameDeletionConfirmationBoxes.TryAdd(p.Id, "");
		StateHasChanged();
	}

	private async Task DeleteCampaignBuff(BuffTemplate template)
	{
		await BuffService.DeleteTemplateAsync(template.Id);
		campaignBuffs = await BuffService.GetCampaignLibraryAsync(CampaignId);
		StateHasChanged();
	}

	// -- Campaign buff add dialog --
	private string cbName = "";
	private string cbIcon = "shield";
	private BuffType cbType = BuffType.Status;
	private List<string> cbEffects = new() { "" };

	private async Task OpenCampaignBuffDialog()
	{
		cbName = "";
		cbIcon = "shield";
		cbType = BuffType.Status;
		cbEffects = new() { "" };
		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "campaignBuffDialog");
		await dialog.InvokeVoidAsync("showModal");
	}

	private void AddCbEffect() => cbEffects.Add("");

	private async Task SaveCampaignBuff()
	{
		if (string.IsNullOrWhiteSpace(cbName)) return;
		var effects = cbEffects
			.Where(f => BuffFormula.Parse(f.Trim().Replace(" ", "")) != null)
			.Select(f => new Effect { Formula = f.Trim().Replace(" ", "") })
			.ToList();
		if (effects.Count == 0) return;

		var template = new BuffTemplate
		{
			Name = cbName,
			Icon = cbIcon,
			Type = cbType,
			Effects = effects,
			CampaignId = CampaignId
		};
		await BuffService.CreateTemplateAsync(template);
		campaignBuffs = await BuffService.GetCampaignLibraryAsync(CampaignId);

		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "campaignBuffDialog");
		await dialog.InvokeVoidAsync("close");
		StateHasChanged();
	}

    public async Task GaugeChangedCallback(Gauge gauge)
    {
        if (gauge.Id == Guid.Empty)
            gauge.Id = Guid.NewGuid();


        <!-- Console.WriteLine($"Gauges: {Char.Gauges.Count()}"); -->


        <!-- await CharService.UpdateGaugeAsync(gauge); -->
        await CharService.UpdateGaugeAsync(gauge);
        <!-- Console.WriteLine($"Gauges: {Char.Gauges.Count()}"); -->
        
    }


	private string GetIdentifier(Campaign campaign, string modalType) {
	    var clean = new string(campaign.Name.Where(char.IsLetter).ToArray());
	    return clean + modalType;
	}
	private string GetIdentifier(PlayerCharacter character, string modalType) {
	    var clean = new string(character.Name?.Where(char.IsLetter).ToArray());
	    return clean + modalType;
	}
    

	protected async override Task OnInitializedAsync()
    {
		NameDeletionConfirmationBoxes = new();

        var campaign = await CampaignService.GetByIdAsync(CampaignId);

        campaign.Players = campaign.Players ?? new List<PlayerCharacter>();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var discordId = user.FindFirst("discord_id")?.Value ?? "Not logged in";

		DiscordId = discordId;

        if (true )
        {
            Campaign = campaign;
			campaignBuffs = await BuffService.GetCampaignLibraryAsync(CampaignId);

			foreach(PlayerCharacter player in Campaign?.Players) {
				NameDeletionConfirmationBoxes[player.Id] = "";
			}

            LiveUpdates.OnCampaignChanged += OnCampaignUpdated;
            LiveUpdates.OnCharacterChanged += OnCharacterUpdated;
        }
        else
        {
            Navigation.NavigateTo("/forbidden");
        }
    }

    private async void OnCampaignUpdated(int campaignId)
    {
        if (campaignId != CampaignId) return;
        await RefreshCampaignData();
    }

    private async void OnCharacterUpdated(int characterId)
    {
        if (Campaign?.Players == null) return;
        if (!Campaign.Players.Any(p => p.Id == characterId)) return;
        await RefreshCampaignData();
    }

    private async Task RefreshCampaignData()
    {
        await InvokeAsync(async () =>
        {
            var campaign = await CampaignService.GetByIdAsync(CampaignId);
            if (campaign != null)
            {
                campaign.Players = campaign.Players ?? new List<PlayerCharacter>();
                Campaign = campaign;
                campaignBuffs = await BuffService.GetCampaignLibraryAsync(CampaignId);

                foreach (PlayerCharacter player in Campaign.Players)
                {
                    NameDeletionConfirmationBoxes.TryAdd(player.Id, "");
                }
                StateHasChanged();
            }
        });
    }

    void AddCharacter()
    {
        Campaign.Players.Add(new PlayerCharacter(){Campaign = Campaign});
        Console.WriteLine($"Added character, total now: {Campaign.Players.Count}");
    }

    async Task SaveAsync()
    {
        await CampaignService.UpdateAsync(Campaign);
        Console.WriteLine($"Saved campaign {Campaign.Id}: {Campaign.Name}, owned by {Campaign.DungeonMasterId}");
    }

    public void Dispose()
    {
        LiveUpdates.OnCampaignChanged -= OnCampaignUpdated;
        LiveUpdates.OnCharacterChanged -= OnCharacterUpdated;
    }
}
