@rendermode InteractiveServer
@page "/campaigns/{campaignId:int}"
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CampaignService CampaignService
@inject PlayerCharacterService CharService
@inject BuffService BuffService
@inject IJSRuntime JS
@inject LiveUpdateService LiveUpdates
@implements IDisposable
@attribute [Authorize(Policy = "HasDiscordId")]


@if(Campaign != null) {

	<Modal Title="Edit Campaign" id="editCampaignDialog">
	    <div class=p-3>
			<CampaignCRUD Campaign="@Campaign"/>
	    </div>
	</Modal>

    <Modal Title="Roll" id="rollDialog">
        <div class=p-3>
            <RollMenu Character="@_rollDialogCharacter" />
        </div>
    </Modal>

    <div class="disable-dbl-tap-zoom container-fluid mt-4 vh-100" style="overflow: auto">
        <!-- Header: title + tags + dice -->
        <div class="d-flex flex-nowrap align-items-start p-2">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center">
                    <span class="fs-2">@Campaign.Name</span>
                    <button class="fs-3 ms-2" onClick="editCampaignDialog.showModal()" style="color:var(--accent)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                        </svg>
                    </button>
                </div>
                <div class="d-flex gap-2 mt-1">
                    @if (!string.IsNullOrEmpty(Campaign.DefaultRollDie))
                    {
                        <span class="badge bg-secondary">Default die: @Campaign.DefaultRollDie</span>
                    }
                    <span class="badge bg-secondary">Modifier formula: @(Campaign.StatModifierFormula ?? "5e")</span>
                </div>
            </div>
            <a onClick="rollDialog.showModal()" class="btn btn-primary p-2 rounded-3 d-flex justify-content-center flex-shrink-0">
                <svg width="50" height="45" xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-dice-5-fill m-auto" viewBox="0 0 16 16">
                    <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
                </svg>
            </a>
        </div>

        <!-- Two-column layout: players left, modifier library right -->
        <div class="d-flex flex-column flex-xl-row gap-3 mt-2 align-items-stretch align-items-xl-start">
            <div style="flex: 1 1 0%; min-width: 0">
                <div class="d-flex align-items-center mb-2">
                    <h5 class="mb-0">Players (@VisiblePlayers.Count())</h5>
                    @if(IsDM) {
                        <button class="btn btn-primary btn-sm ms-2" @onclick="OpenPlayerPresetPickerAsync">+</button>
                    }
                </div>
                @if(Campaign.Players != null){
                <div class="player-grid">
                    @foreach(PlayerCharacter player in VisiblePlayers) {
                        NameDeletionConfirmationBoxes.TryAdd(player.Id, "");
                        <Modal Title="Edit Player" id="@(GetIdentifier(player,"edit"))">
                            <div class=p-3>
                                <CharacterCRUD Character="@player"/>
                            </div>
                        </Modal>

                        <Modal Title="Delete Player" id="@(GetIdentifier(player,"delete"))">
                            <h2>Do you really want to delete the character "@player.Name"?</h2>
                            <br>
                            <div class="form-group">
                                <h5 class="text-muted">Please type the name of your campaign to confirm:</h5>
                                <input class="form-input fs-5 m-2" placeholder=@player.Name @bind="@NameDeletionConfirmationBoxes[player.Id]"
                                       @onkeydown="async e => await OnDeleteConfirmKeyDown(e, player, false)">
                            </div>
                            <button class="btn btn-danger w-100"
                                    disabled="@(NameDeletionConfirmationBoxes[player.Id] != player.Name)"
                                    @onclick="async () => await DeletePlayerWithCloseAsync(player)">
                                Delete
                            </button>
                        </Modal>

                        <div class="card player-card">
                            <div class="card-header py-0 px-2">
                                <div class="text-white d-flex align-items-center">
                                    @if(player.UserId == DiscordId) {
                                        <a style="color:var(--accent)" href="@($"/characters/{player.Id}")">@(player.Name ?? "Unknown") (you)</a>
                                    }
                                    else {
                                        <span>@(player.Name ?? "Unknown")</span>
                                    }
                                    <div class="flex-grow-1"></div>
                                    <button class="text-danger p-1" @onclick="async () => await HandlePlayerDeleteClickAsync(player)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                            <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                        </svg>
                                    </button>
                                    <button class="p-1" style="color:var(--accent)" onClick="@(GetIdentifier(player,"edit")).showModal()">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-2 w-100">
                                @if(player.Gauges != null) {
                                    <div class="d-flex align-items-center gap-3 w-100">
                                        <div class="d-flex flex-column gap-1" style="flex: 1 1 0%; min-width: 0">
                                            @foreach(Gauge gauge in player.Gauges) {
                                                <Bar GaugeInstance="@gauge" />
                                            }
                                        </div>
                                        @{
                                            var lastRoll = player?.Rolls?.OrderByDescending(r => r.Timestamp).FirstOrDefault();
                                        }
                                        @if (lastRoll != null)
                                        {
                                            <div class="flex-shrink-0">
                                                <DieShape Expression="@(lastRoll.Rolls?.FirstOrDefault()?.Expression ?? lastRoll.Message)">
                                                    @lastRoll.Result
                                                </DieShape>
                                            </div>
                                        }
                                    </div>
                                }
                                @if(IsDM) {
                                    <div class="d-flex gap-1 mt-1">
                                        <button class="btn btn-sm btn-secondary flex-fill" @onclick="async () => await OpenRollDialogAsync(player)">Roll</button>
                                        <button class="btn btn-sm btn-secondary flex-fill" @onclick="async () => await OpenQuickStatusAsync(player)">+ Status</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                }

            </div>

            <div style="flex: 1 1 280px">
                @if(IsDM) {
                <div class="mt-4">
                    <div class="d-flex w-100 align-items-center mb-2 m-2 flex-wrap gap-2">


                        <input type="checkbox" class="flex-shrink-0" style=""
                               checked="@AllNpcsSelected"
                               @onclick="SelectAllNpcs" />


                        <h5 class="mb-0 flex-grow-1 ">NPCs (@VisibleNpcs.Count())</h5>
                        <input type="number" class="form-control form-control-sm ms-2" style="width:4em" min="1" max="99" @bind="_npcCount" />
                        <button class="btn btn-primary btn-sm" @onclick="OpenNpcPresetPickerAsync">+</button>
                        @if (SelectedNpcIds.Any()) {
                            <button class="btn btn-secondary btn-sm ms-1" @onclick="OpenBulkEditDialogAsync">Edit</button>
                            <button class="btn btn-danger btn-sm ms-1" @onclick="OpenBulkDeleteDialogAsync">Delete</button>
                        }
                    </div>
                    <div class="player-grid">
                        @foreach(PlayerCharacter npc in VisibleNpcs) {
                            NameDeletionConfirmationBoxes.TryAdd(npc.Id, "");
                            <Modal Title="Edit NPC" id="@(GetIdentifier(npc,"edit"))">
                                <div class=p-3>
                                    <CharacterCRUD Character="@npc"/>
                                </div>
                            </Modal>

                            <Modal Title="Delete NPC" id="@(GetIdentifier(npc,"delete"))">
                                <h2>Do you really want to delete the NPC "@npc.Name"?</h2>
                                <br>
                                <div class="form-group">
                                    <h5 class="text-muted">Please type the name to confirm:</h5>
                                    <input class="form-input fs-5 m-2" placeholder=@npc.Name @bind="@NameDeletionConfirmationBoxes[npc.Id]"
                                           @onkeydown="async e => await OnDeleteConfirmKeyDown(e, npc, true)">
                                </div>
                                <button class="btn btn-danger w-100"
                                        disabled="@(NameDeletionConfirmationBoxes[npc.Id] != npc.Name)"
                                        @onclick="async () => await DeleteNpcWithCloseAsync(npc)">
                                    Delete
                                </button>
                            </Modal>

                            <div class="card player-card">
                                <div class="card-header py-0 px-2 d-flex align-items-center">
                                        <input type="checkbox" class="me-2 flex-shrink-0" style="cursor:pointer"
                                               checked="@SelectedNpcIds.Contains(npc.Id)"
                                               @onchange="e => ToggleNpcSelection(npc.Id, (bool)e.Value!)" />
                                        <input class="form-control form-control-sm border-0" style="width:auto; background:rgba(255,255,255,0.1); color:white"
                                               @bind="npc.Name" @bind:event="oninput"
                                               @onblur="async () => await CharService.UpdateAsync(npc)" />
                                        <div class="flex-grow-1"></div>
                                        <button class="text-danger p-1" @onclick="async () => await HandleNpcDeleteClickAsync(npc)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                            </svg>
                                        </button>
                                        <button class="p-1" style="color:var(--accent)" onClick="@(GetIdentifier(npc,"edit")).showModal()">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                            </svg>
                                        </button>
                                </div>
                                <div class="card-body p-2 w-100">
                                    @if(npc.Gauges != null) {
                                        <div class="d-flex align-items-center gap-3 w-100">
                                            <div class="d-flex flex-column gap-1" style="flex: 1 1 0%; min-width: 0">
                                                @foreach(Gauge gauge in npc.Gauges) {
                                                    <Bar GaugeInstance="@gauge" />
                                                }
                                            </div>
                                            @{
                                                var lastNpcRoll = npc?.Rolls?.OrderByDescending(r => r.Timestamp).FirstOrDefault();
                                            }
                                            @if (lastNpcRoll != null)
                                            {
                                                <div class="flex-shrink-0">
                                                    <DieShape Expression="@(lastNpcRoll.Rolls?.FirstOrDefault()?.Expression ?? lastNpcRoll.Message)">
                                                        @lastNpcRoll.Result
                                                    </DieShape>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="d-flex gap-1 mt-1">
                                      <div class="d-flex flex-wrap justify-items-center align-items-center">
                                        <input class="form-control form-control-sm border-0" style="background:white"
                                               placeholder="@(Campaign?.DefaultRollDie ?? "1d20")"
                                               value="@NpcRollFormulas.GetValueOrDefault(npc.Id, "")"
                                               @onchange="e => NpcRollFormulas[npc.Id] = e.Value?.ToString() ?? string.Empty"  />
                                        <button class="btn btn-sm btn-secondary w-100" @onclick="async () => await RollForNpcAsync(npc)">
                                          <svg
                                              width="50"
                                              height="45"
                                              xmlns="http://www.w3.org/2000/svg"
                                              fill="currentColor"
                                              class="bi bi-dice-5-fill m-auto"
                                              viewBox="0 0 16 16">
                                              <path d="M3 0a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3zm2.5 4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0m8 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M12 13.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3M5.5 12a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M8 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
                                          </svg>
                                        </button>
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center gap-1 w-100">
                                            @if(npc.Buffs != null && npc.Buffs.Any()) {
                                                @foreach (var buff in npc.Buffs) {
                                                    <span class="badge bg-secondary d-flex align-items-center gap-1" style="font-size: 0.8em; cursor: pointer"
                                                          @onclick="async () => await RemoveNpcBuffAsync(buff)">
                                                        <BuffIcon Name="@(buff.Template?.Icon ?? "shield")" Size="0.9em" />
                                                        @(buff.Template?.Name ?? "?")
                                                        <span style="opacity: 0.6">&times;</span>
                                                    </span>
                                                }
                                            } else {
                                                <span class="text-muted" style="font-size: 0.8em">(no statuses)</span>
                                            }
                                            <div style="position: relative; display: inline-block">
                                                <button class="btn btn-sm btn-secondary" style="padding: 0 0.4em; line-height: 1.4"
                                                        @onclick="() => ToggleNpcStatusPopover(npc.Id)">+</button>
                                                @if (_npcStatusPopoverId == npc.Id) {
                                                    <div class="card" style="position: absolute; bottom: 100%; left: 0; z-index: 10; min-width: 160px; max-height: 200px; overflow-y: auto; margin-bottom: 4px">
                                                        <div class="card-body p-1 d-flex flex-column gap-1">
                                                            @if (campaignBuffs.Any()) {
                                                                @foreach (var buff in campaignBuffs.OrderBy(b => b.Name)) {
                                                                    <button class="btn btn-sm btn-secondary text-start d-flex align-items-center gap-1"
                                                                            @onclick="async () => await ApplyNpcStatusAsync(npc, buff)">
                                                                        <BuffIcon Name="@buff.Icon" Size="0.9em" />
                                                                        <span style="font-size: 0.85em">@buff.Name</span>
                                                                    </button>
                                                                }
                                                            } else {
                                                                <span class="text-muted p-1" style="font-size: 0.8em">No buffs defined</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                }
            </div>
        </div>


        <Modal Title="Apply Status" id="quickStatusDialog">
            <div class="p-3 d-flex flex-column gap-2" style="min-width: 260px">
                @if (campaignBuffs.Any()) {
                    @foreach (var buff in campaignBuffs.OrderBy(b => b.Name)) {
                        <button class="btn btn-secondary text-start d-flex align-items-center gap-2"
                                @onclick="async () => await ApplyQuickStatusAsync(buff)">
                            <BuffIcon Name="@buff.Icon" />
                            <span>@buff.Name</span>
                        </button>
                    }
                } else {
                    <p class="text-muted">No campaign buffs defined.</p>
                }
                <button class="btn btn-secondary mt-2" onclick="quickStatusDialog.close()">Close</button>
            </div>
        </Modal>

        <Modal Title="Delete selected NPCs" id="bulkDeleteNpcDialog">
            <div class="p-3">
                <p>Delete @SelectedNpcIds.Count selected NPC(s)? This cannot be undone.</p>
                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-secondary flex-fill" onclick="bulkDeleteNpcDialog.close()">Cancel</button>
                    <button class="btn btn-danger flex-fill" @onclick="DeleteSelectedNpcsAsync">Delete</button>
                </div>
            </div>
        </Modal>

        <Modal Title="Edit selected NPCs" id="bulkEditNpcDialog">
            <div class="p-3 d-flex flex-column gap-3" style="min-width: 320px">
                <p class="text-muted mb-0" style="font-size:0.85em">Changes apply to all @SelectedNpcIds.Count selected NPC(s). Leave a field blank to keep existing values.</p>
                @foreach (var gaugeName in BulkGaugeNames) {
                    <div>
                        <label class="form-label mb-1">@gaugeName</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <input type="number" class="form-control" placeholder="Value"
                                       value="@(BulkGaugeValues.GetValueOrDefault(gaugeName))"
                                       @onchange="e => BulkGaugeValues[gaugeName] = e.Value is string s && int.TryParse(s, out var v) ? v : null" />
                            </div>
                            <div class="flex-fill">
                                <input type="number" class="form-control" placeholder="Max"
                                       value="@(BulkGaugeMaxes.GetValueOrDefault(gaugeName))"
                                       @onchange="e => BulkGaugeMaxes[gaugeName] = e.Value is string s && int.TryParse(s, out var v) ? v : null" />
                            </div>
                        </div>
                    </div>
                }
                @if (!BulkGaugeNames.Any()) {
                    <p class="text-muted">Selected NPCs have no gauges to edit.</p>
                }
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary flex-fill" onclick="bulkEditNpcDialog.close()">Cancel</button>
                    <button class="btn btn-primary flex-fill" @onclick="ApplyBulkEditsAsync">Apply</button>
                </div>
            </div>
        </Modal>

        <Modal Title="Select Player Template" id="playerPresetDialog">
            <div class="p-3 d-flex flex-column gap-2" style="min-width: 260px">
                @foreach (var preset in Campaign.Presets ?? []) {
                    <button class="btn btn-secondary text-start" @onclick="async () => await CreatePlayerFromPresetAsync(preset.Id)">
                        @preset.Name
                    </button>
                }
                <button class="btn btn-secondary mt-1" onclick="playerPresetDialog.close()">Cancel</button>
            </div>
        </Modal>

        <Modal Title="Select NPC Template" id="npcPresetDialog">
            <div class="p-3 d-flex flex-column gap-2" style="min-width: 260px">
                @foreach (var preset in Campaign.Presets ?? []) {
                    <button class="btn btn-secondary text-start" @onclick="async () => await CreateNpcsFromPresetAsync(preset.Id)">
                        @preset.Name
                    </button>
                }
                <button class="btn btn-secondary mt-1" onclick="npcPresetDialog.close()">Cancel</button>
            </div>
        </Modal>

    </div>


}

@code {
	Campaign? Campaign;
    [Parameter] public int CampaignId { get; set; }

	List<BuffTemplate> campaignBuffs = new();
	Dictionary<int,string> NameDeletionConfirmationBoxes {get; set;} = new();

	private string DiscordId {get; set;}

	private bool IsDM => Campaign?.DungeonMasterId == DiscordId;

	private IEnumerable<PlayerCharacter> VisiblePlayers => (Campaign?.Players ?? Enumerable.Empty<PlayerCharacter>())
		.Where(p => !p.IsNpc && (IsDM || p.UserId == DiscordId))
		.OrderByDescending(c => c.Rolls?.Any() ?? false)
		.ThenByDescending(c => c.Rolls != null && c.Rolls.Any() ? c.Rolls.Max(r => r.Timestamp) : null);

	private IEnumerable<PlayerCharacter> VisibleNpcs => (Campaign?.Players ?? Enumerable.Empty<PlayerCharacter>())
		.Where(p => p.IsNpc)
		.OrderBy(p => p.Name);

	// -- NPC multi-select --
	private HashSet<int> SelectedNpcIds = new();
	private IEnumerable<PlayerCharacter> SelectedNpcs => VisibleNpcs.Where(n => SelectedNpcIds.Contains(n.Id));
	private IEnumerable<string> BulkGaugeNames => SelectedNpcs
		.Where(n => n.Gauges != null)
		.SelectMany(n => n.Gauges.Select(g => g.Name ?? ""))
		.Where(n => !string.IsNullOrEmpty(n))
		.Distinct()
		.OrderBy(n => n);

	private Dictionary<string, int?> BulkGaugeValues = new();
	private Dictionary<string, int?> BulkGaugeMaxes = new();

  private bool? AllNpcsSelected => VisibleNpcs.Count() > 0 && VisibleNpcs.Count() == SelectedNpcIds.Count();
  
  private void SelectAllNpcs() {
    if(AllNpcsSelected == true) {
      SelectedNpcIds = new();      
    }
    else {
        foreach (PlayerCharacter npc in VisibleNpcs)
              SelectedNpcIds.Add(npc.Id);
    }
  }

	private void ToggleNpcSelection(int id, bool selected)
	{
		if (selected) SelectedNpcIds.Add(id);
		else SelectedNpcIds.Remove(id);
	}

	private async Task OpenBulkDeleteDialogAsync()
	{
		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "bulkDeleteNpcDialog");
		await dialog.InvokeVoidAsync("showModal");
	}

	private async Task DeleteSelectedNpcsAsync()
	{
		await CloseModalAsync("bulkDeleteNpcDialog");
		foreach (var npc in SelectedNpcs.ToList())
			await DeletePlayerAsync(npc);
		SelectedNpcIds.Clear();
	}

	private async Task OpenBulkEditDialogAsync()
	{
		BulkGaugeValues = BulkGaugeNames.ToDictionary(n => n, _ => (int?)null);
		BulkGaugeMaxes = BulkGaugeNames.ToDictionary(n => n, _ => (int?)null);
		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "bulkEditNpcDialog");
		await dialog.InvokeVoidAsync("showModal");
	}

	private async Task ApplyBulkEditsAsync()
	{
		foreach (var npc in SelectedNpcs)
		{
			foreach (var gauge in npc.Gauges ?? Enumerable.Empty<Gauge>())
			{
				if (string.IsNullOrEmpty(gauge.Name)) continue;
				bool changed = false;
				if (BulkGaugeValues.TryGetValue(gauge.Name, out var val) && val.HasValue)
				{
					gauge.Value = val.Value;
					changed = true;
				}
				if (BulkGaugeMaxes.TryGetValue(gauge.Name, out var max) && max.HasValue)
				{
					gauge.Max = max.Value;
					changed = true;
				}
				if (changed) await CharService.UpdateGaugeAsync(gauge);
			}
		}
		await CloseModalAsync("bulkEditNpcDialog");
	}

	private async Task OnDeleteConfirmKeyDown(KeyboardEventArgs e, PlayerCharacter character, bool isNpc)
	{
		if (e.Key != "Enter") return;
		if (NameDeletionConfirmationBoxes.TryGetValue(character.Id, out var typed) && typed == character.Name)
		{
			if (isNpc) await DeleteNpcWithCloseAsync(character);
			else await DeletePlayerWithCloseAsync(character);
		}
	}

	public async Task DeletePlayerAsync(PlayerCharacter character) {
		await CampaignService.RemovePlayerAsync(Campaign,character);
	}

	private async Task CloseModalAsync(string id)
	{
		await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", id);
		await dialog.InvokeVoidAsync("close");
	}

	private async Task DeletePlayerWithCloseAsync(PlayerCharacter player)
	{
		await CloseModalAsync(GetIdentifier(player, "delete"));
		await DeletePlayerAsync(player);
	}

	private async Task DeleteNpcWithCloseAsync(PlayerCharacter npc)
	{
		await CloseModalAsync(GetIdentifier(npc, "delete"));
		await DeleteNpcWithGraceAsync(npc);
	}

	private DateTime? _lastNpcDeleted;
	private bool NpcGracePeriodActive => _lastNpcDeleted.HasValue && (DateTime.UtcNow - _lastNpcDeleted.Value).TotalSeconds < 30;

	private async Task HandlePlayerDeleteClickAsync(PlayerCharacter player)
	{
		if (player.Name == "New Player")
			await DeletePlayerAsync(player);
		else
			await JS.InvokeVoidAsync("eval", $"document.getElementById('{GetIdentifier(player, "delete")}').showModal()");
	}

	private async Task HandleNpcDeleteClickAsync(PlayerCharacter npc)
	{
		if (npc.Name == "New NPC" || NpcGracePeriodActive)
		{
			_lastNpcDeleted = DateTime.UtcNow;
			await DeletePlayerAsync(npc);
		}
		else
		{
			await JS.InvokeVoidAsync("eval", $"document.getElementById('{GetIdentifier(npc, "delete")}').showModal()");
		}
	}

	private async Task DeleteNpcWithGraceAsync(PlayerCharacter npc)
	{
		_lastNpcDeleted = DateTime.UtcNow;
		await DeletePlayerAsync(npc);
	}

