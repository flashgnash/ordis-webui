@rendermode InteractiveServer
@inject IJSRuntime JS
@inject BuffService BuffService

<!-- Active buffs inline panel -->
<div class="card m-0 border-0">
    <div class="card-body m-0 p-0">
        <!-- Tabs -->
        <div class="d-flex align-items-center" style="border-bottom: 1px solid rgba(255,255,255,0.1); overflow: hidden">
            <div class="d-flex flex-grow-1" style="min-width: 0; overflow-x: auto">
                @foreach (var tab in Tabs)
                {
                    var isActive = activeTab == tab;
                    var count = GetBuffsForTab(tab).Count();
                    <a href="javascript:void(0)"
                       @onclick="() => activeTab = tab"
                       style="padding: 0.5em 0.7em; text-decoration: none; color: @(isActive ? "var(--accent)" : "rgba(255,255,255,0.5)"); border-bottom: 2px solid @(isActive ? "var(--accent)" : "transparent"); font-size: 0.85em; white-space: nowrap">
                        @TabLabel(tab)
                        @if (count > 0)
                        {
                            <span style="margin-left: 0.3em; font-size: 0.85em; opacity: 0.7">@count</span>
                        }
                    </a>
                }
            </div>
            <button class="btn btn-primary btn-sm flex-shrink-0 me-2" @onclick="OpenAddDialog">
                +
            </button>
        </div>

        <div class="p-2">
            @{ var tabBuffs = GetBuffsForTab(activeTab).ToList(); }
            @if (tabBuffs.Any())
            {
                @foreach (var cb in tabBuffs)
                {
                    <div class="py-1">
                        <div class="d-flex flex-nowrap align-items-center gap-2">
                            <span class="flex-shrink-0 text-muted" style="width: 1.5em; text-align: center">
                                <BuffIcon Name="@cb.Template.Icon" />
                            </span>
                            <span>@cb.Template.Name</span>
                            @if (cb.Template.Effects.Any(e => e.IsCumulative))
                            {
                                var gaugeValueOnly = cb.Template.Effects
                                    .Where(e => e.IsCumulative)
                                    .All(e => BuffFormula.Parse(e.Formula)?.target.EndsWith(".value", StringComparison.OrdinalIgnoreCase) == true);

                                <div class="flex-grow-1"></div>

                                if (gaugeValueOnly)
                                {
                                    <button class="btn btn-success d-flex align-items-center justify-content-center"
                                            style="width: 1.8em; height: 1.8em; padding: 0"
                                            @onclick="() => ApplyStack(cb)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-danger d-flex align-items-center justify-content-center"
                                            style="width: 1.8em; height: 1.8em; padding: 0"
                                            @onclick="() => ChangeStacks(cb, -1)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"/>
                                        </svg>
                                    </button>
                                    <span style="font-size: 0.95em; min-width: 1.5em; text-align: center">@cb.Stacks</span>
                                    <button class="btn btn-success d-flex align-items-center justify-content-center"
                                            style="width: 1.8em; height: 1.8em; padding: 0"
                                            @onclick="() => ApplyStack(cb)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
                                        </svg>
                                    </button>
                                }
                            }
                        </div>
                        <div class="d-flex flex-nowrap align-items-center ms-4 mt-1 gap-2">
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var effect in cb.Template.Effects)
                                {
                                    var p = BuffFormula.Parse(effect.Formula);
                                    var isGaugeMax = p != null
                                        && !p.Value.target.EndsWith(".value", StringComparison.OrdinalIgnoreCase)
                                        && Character?.Gauges?.Any(g => g.Name.Equals(p.Value.target, StringComparison.OrdinalIgnoreCase)) == true;
                                    var display = BuffFormula.FormatDisplay(effect.Formula);
                                    if (isGaugeMax)
                                        display = "Max " + display;
                                    <span class="badge @(p?.op is "+=" or "*=" ? "bg-success" : "bg-danger")"
                                          style="font-size: 0.7em">
                                        @display
                                    </span>
                                }
                            </div>
                            <div class="flex-grow-1"></div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <button class="btn btn-sm" style="color:var(--accent); padding: 2px 7px; line-height: 1"
                                        @onclick="() => OpenEditDialog(cb)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16">
                                        <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z"/>
                                    </svg>
                                </button>
                                <button class="btn btn-danger btn-sm"
                                        style="padding: 2px 7px; line-height: 1"
                                        @onclick="() => RemoveBuff(cb)">
                                    x
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <span class="text-muted">No @TabLabel(activeTab).ToLower()</span>
            }
        </div>
    </div>
</div>

<!-- Add/Edit modifier dialog -->
<Modal Title="@(editingBuff != null ? "Edit modifier" : "Add modifier")" id="addBuffDialog">
    <div class="p-3 d-flex h-100 flex-column gap-3" style="min-width: 360px">

        <div class="d-flex flex-wrap gap-3">
            <div class="flex-grow-1" style="min-width: 150px">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="newName" @bind:event="oninput" @bind:after="OnNameChanged" />
                @if (editingBuff == null && searchResults.Any())
                {
                    <div class="list-group mt-1" style="max-height: 10em; overflow: auto">
                        @foreach (var t in searchResults)
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-1"
                                    @onclick="() => ImportTemplate(t)">
                                <BuffIcon Name="@t.Icon" Size="1em" />
                                <span>@t.Name</span>
                                @if (t.CampaignId != null)
                                {
                                    <span class="badge bg-info ms-auto" style="font-size: 0.7em">Campaign</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-auto" style="font-size: 0.7em">Personal</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="flex-grow-1" style="min-width: 120px">
                <label class="form-label">Type</label>
                <select class="form-select bg-dark text-white border-0" @bind="newType">
                    @foreach (var t in Tabs)
                    {
                        <option value="@t">@t.ToString()</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-1">
            @foreach (var icon in BuffIcon.AllIcons)
            {
                var selected = newIcon == icon;
                <button type="button"
                        class="btn btn-sm d-flex align-items-center justify-content-center"
                        style="width: 2.2em; height: 2.2em; padding: 0; border: 2px solid @(selected ? "var(--accent)" : "transparent"); color: @(selected ? "var(--accent)" : "rgba(255,255,255,0.5)")"
                        @onclick="() => newIcon = icon">
                    <BuffIcon Name="@icon" Size="1.1em" />
                </button>
            }
        </div>

        <div class="d-flex flex-column gap-1">
            <div class="d-flex align-items-center">
                <label class="form-label mb-0">Effects (@draftEffects.Count)</label>
                <button type="button" class="btn btn-primary btn-sm ms-auto" @onclick="AddEmptyDraft">+</button>
            </div>

            @for (int i = 0; i < draftEffects.Count; i++)
            {
                var d = draftEffects[i];
                var idx = i;
                <div class="card border-0 p-3 m-0" style="background: var(--bg-dark)">
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        @if (!d.AdvancedMode)
                        {
                            <select class="form-select border-0" style="width: auto; flex: 1 1 auto; min-width: 6em"
                                    value="@d.Target"
                                    @onchange="(e) => OnTargetChanged(d, e.Value?.ToString() ?? string.Empty)">
                                @if (Character?.StatBlock?.Stats?.Any() == true)
                                {
                                    <optgroup label="Stats">
                                        @foreach (var s in Character.StatBlock.Stats)
                                        {
                                            <option value="@s.Name.ToLower()">@s.Name</option>
                                        }
                                    </optgroup>
                                }
                                @if (Character?.StatBlock?.SpecialStats?.Any() == true)
                                {
                                    <optgroup label="Special Stats">
                                        @foreach (var s in Character.StatBlock.SpecialStats)
                                        {
                                            <option value="@s.Name.ToLower()">@s.Name</option>
                                        }
                                    </optgroup>
                                }
                                @if (Character?.Gauges?.Any() == true)
                                {
                                    <optgroup label="Gauge Max">
                                        @foreach (var g in Character.Gauges)
                                        {
                                            <option value="@g.Name.ToLower()">@g.Name (max)</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Gauge Value">
                                        @foreach (var g in Character.Gauges)
                                        {
                                            <option value="@(g.Name.ToLower() + ".value")">@g.Name (value)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <select class="form-select border-0" style="width: auto; flex: 0 0 auto" @bind="d.Op">
                                <option value="+=">+</option>
                                <option value="-=">-</option>
                                <option value="*=">&times;</option>
                                <option value="/=">&divide;</option>
                            </select>
                            <input type="number" class="form-control border-0" style="width: 5em; flex: 0 0 auto; color: black" @bind="d.Value" />
                        }
                        else
                        {
                            <input class="form-control border-0" style="flex: 1 1 auto; min-width: 8em; color: black"
                                   @bind="d.Raw" placeholder="e.g. str+=dex/2" />
                        }

                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <div class="d-flex align-items-center gap-1">
                                <input type="checkbox" class="form-check-input mt-0"
                                       checked="@d.IsCumulative"
                                       @onchange="() => d.IsCumulative = !d.IsCumulative" />
                                <label class="form-check-label text-muted" style="font-size: 0.8em; white-space: nowrap">Stack</label>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <input type="checkbox" class="form-check-input mt-0"
                                       checked="@d.AdvancedMode"
                                       @onchange="() => ToggleDraftMode(d)" />
                                <label class="form-check-label text-muted" style="font-size: 0.8em; white-space: nowrap">Advanced</label>
                            </div>
                            <button type="button" class="btn btn-danger btn-sm d-flex align-items-center justify-content-center"
                                    style="width: 2em; height: 2em; padding: 0"
                                    @onclick="() => draftEffects.RemoveAt(idx)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                    <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="flex-grow-1"></div>

        @if (editingBuff != null)
        {
            <div class="d-flex gap-2">
                @if (Character?.Campaign != null)
                {
                    <button type="button" class="btn btn-outline-info flex-fill" @onclick="ExportEditingToCampaign"
                            title="Export to campaign library">
                        Export to campaign
                    </button>
                }
                @if (editingBuff.Template.SourceTemplate != null && editingBuff.Template.IsOutOfSync(editingBuff.Template.SourceTemplate))
                {
                    <button type="button" class="btn btn-warning flex-fill" @onclick="PullFromCampaign"
                            title="Reset to campaign default">
                        Pull from campaign
                    </button>
                }
            </div>
        }

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary flex-fill" onclick="addBuffDialog.close()">
                Cancel
            </button>
            <button type="button" class="btn btn-primary flex-fill" @onclick="CommitBuff">
                Save
            </button>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public PlayerCharacter? Character { get; set; }
    [Parameter] public string? OwnerId { get; set; }
    [Parameter] public List<CharacterBuff> CharacterBuffs { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<CharacterBuff> OnStackApplied { get; set; }

    private static readonly BuffType[] Tabs = [BuffType.Equipment, BuffType.Status, BuffType.Skill];
    private BuffType activeTab = BuffType.Equipment;

    private IEnumerable<CharacterBuff> GetBuffsForTab(BuffType type) =>
        CharacterBuffs.Where(cb => cb.Template.Type == type).OrderBy(cb => cb.Template.Name);

    private static string TabLabel(BuffType type) => type switch
    {
        BuffType.Equipment => "Equipment",
        BuffType.Status => "Statuses",
        BuffType.Skill => "Skill Modifiers",
        _ => type.ToString()
    };

    // -- Search (integrated with name field, only for new buffs) --
    private List<BuffTemplate> searchResults = new();

    private async Task OnNameChanged()
    {
        if (editingBuff != null || string.IsNullOrWhiteSpace(newName))
        {
            searchResults.Clear();
            return;
        }
        searchResults = await BuffService.SearchTemplatesAsync(
            newName, OwnerId ?? "", Character?.Campaign?.Id);
    }

    private async Task ImportTemplate(BuffTemplate template)
    {
        if (Character == null) return;

        Guid templateIdToApply;
        if (template.CampaignId != null && OwnerId != null)
        {
            // Campaign template: create a linked player-level copy
            var playerCopy = await BuffService.ImportFromCampaignAsync(template.Id, OwnerId);
            templateIdToApply = playerCopy.Id;
        }
        else
        {
            templateIdToApply = template.Id;
        }

        await BuffService.ApplyBuffAsync(Character.Id, templateIdToApply);
        searchResults.Clear();
        await CloseDialog();
        await OnChanged.InvokeAsync();
    }

    private async Task ExportEditingToCampaign()
    {
        if (editingBuff == null || Character?.Campaign == null) return;
        await BuffService.ExportToCampaignAsync(editingBuff.Template.Id, Character.Campaign.Id);
        // Reload to pick up the new SourceTemplateId link
        await OnChanged.InvokeAsync();
    }

    private async Task PullFromCampaign()
    {
        if (editingBuff == null) return;
        await BuffService.PullFromSourceAsync(editingBuff.Template.Id);
        // Reload template and refresh the edit dialog
        await OnChanged.InvokeAsync();
        // Re-open with fresh data
        var refreshed = (await BuffService.GetCharacterBuffsAsync(Character!.Id))
            .FirstOrDefault(cb => cb.Id == editingBuff.Id);
        if (refreshed != null)
            await OpenEditDialog(refreshed);
    }

    // -- Draft state for add/edit --
    private class DraftEffect
    {
        public bool AdvancedMode { get; set; }
        public string Target { get; set; } = "";
        public string Op { get; set; } = "+=";
        public string Value { get; set; } = "";
        public string Raw { get; set; } = "";
        public bool IsCumulative { get; set; }

        public Effect? ToEffect()
        {
            string? formula;
            if (AdvancedMode)
            {
                var raw = Raw.Trim().Replace(" ", "");
                formula = BuffFormula.Parse(raw) != null ? raw : null;
            }
            else
            {
                if (string.IsNullOrWhiteSpace(Target) || string.IsNullOrWhiteSpace(Value))
                    formula = null;
                else
                    formula = $"{Target}{Op}{Value.Trim()}";
            }
            if (formula == null) return null;
            return new Effect
            {
                Formula = formula,
                IsCumulative = IsCumulative,
                Stacks = IsCumulative ? 0 : 1
            };
        }

        public static DraftEffect FromEffect(Effect effect)
        {
            var parsed = BuffFormula.Parse(effect.Formula);
            if (parsed != null && double.TryParse(parsed.Value.expr,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out _))
            {
                return new DraftEffect
                {
                    Target = parsed.Value.target,
                    Op = parsed.Value.op,
                    Value = parsed.Value.expr,
                    IsCumulative = effect.IsCumulative
                };
            }
            return new DraftEffect { AdvancedMode = true, Raw = effect.Formula, IsCumulative = effect.IsCumulative };
        }
    }

    private CharacterBuff? editingBuff;
    private string newName = "";
    private string newIcon = "shield";
    private BuffType newType = BuffType.Equipment;
    private List<DraftEffect> draftEffects = new();

    private string DefaultTarget() =>
        Character?.StatBlock?.Stats?.FirstOrDefault()?.Name?.ToLower()
        ?? Character?.StatBlock?.SpecialStats?.FirstOrDefault()?.Name?.ToLower()
        ?? Character?.Gauges?.FirstOrDefault()?.Name?.ToLower()
        ?? "";

    private void OnTargetChanged(DraftEffect d, string value)
    {
        d.Target = value;
        if (value.EndsWith(".value", StringComparison.OrdinalIgnoreCase))
            d.IsCumulative = true;
    }

    private async Task OpenAddDialog()
    {
        editingBuff = null;
        newName = "";
        newIcon = "shield";
        newType = activeTab;
        searchResults.Clear();
        draftEffects = new();
        AddEmptyDraft();
        await OpenDialog();
    }

    private async Task OpenEditDialog(CharacterBuff cb)
    {
        editingBuff = cb;
        newName = cb.Template.Name;
        newIcon = cb.Template.Icon;
        newType = cb.Template.Type;
        searchResults.Clear();
        draftEffects = cb.Template.Effects.Select(DraftEffect.FromEffect).ToList();
        await OpenDialog();
    }

    private async Task OpenDialog()
    {
        await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "addBuffDialog");
        await dialog.InvokeVoidAsync("showModal");
    }

    private async Task CloseDialog()
    {
        await using var dialog = await JS.InvokeAsync<IJSObjectReference>("document.getElementById", "addBuffDialog");
        await dialog.InvokeVoidAsync("close");
    }

    private void AddEmptyDraft() =>
        draftEffects.Add(new DraftEffect { Target = DefaultTarget() });

    private void ToggleDraftMode(DraftEffect d)
    {
        if (!d.AdvancedMode)
        {
            if (!string.IsNullOrWhiteSpace(d.Target) && !string.IsNullOrWhiteSpace(d.Value))
                d.Raw = $"{d.Target}{d.Op}{d.Value.Trim()}";
        }
        else
        {
            var raw = d.Raw.Trim().Replace(" ", "");
            var parsed = BuffFormula.Parse(raw);
            if (parsed != null && double.TryParse(parsed.Value.expr,
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out _))
            {
                d.Target = parsed.Value.target;
                d.Op = parsed.Value.op;
                d.Value = parsed.Value.expr;
            }
        }
        d.AdvancedMode = !d.AdvancedMode;
    }

    private async Task CommitBuff()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        if (Character == null) return;

        var effects = draftEffects
            .Select(d => d.ToEffect())
            .Where(e => e != null)
            .Cast<Effect>()
            .ToList();

        if (effects.Count == 0) return;

        if (editingBuff != null)
        {
            // Update existing template
            editingBuff.Template.Name = newName;
            editingBuff.Template.Icon = newIcon;
            editingBuff.Template.Type = newType;
            editingBuff.Template.Effects = effects;
            await BuffService.UpdateTemplateAsync(editingBuff.Template);
            editingBuff = null;
        }
        else
        {
            // Create new template in player library and apply to character
            var template = new BuffTemplate
            {
                Name = newName,
                Icon = newIcon,
                Type = newType,
                Effects = effects,
                OwnerId = OwnerId
            };
            await BuffService.CreateTemplateAsync(template);
            await BuffService.ApplyBuffAsync(Character.Id, template.Id);
        }

        newName = "";
        draftEffects.Clear();
        await CloseDialog();
        await OnChanged.InvokeAsync();
    }

    private async Task ApplyStack(CharacterBuff cb)
    {
        cb.Stacks++;
        await BuffService.UpdateStacksAsync(cb.Id, cb.Stacks);
        await OnStackApplied.InvokeAsync(cb);
        await OnChanged.InvokeAsync();
    }

    private async Task ChangeStacks(CharacterBuff cb, int delta)
    {
        cb.Stacks = Math.Max(0, cb.Stacks + delta);
        await BuffService.UpdateStacksAsync(cb.Id, cb.Stacks);
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveBuff(CharacterBuff cb)
    {
        await BuffService.RemoveBuffAsync(cb.Id);
        await OnChanged.InvokeAsync();
    }
}
